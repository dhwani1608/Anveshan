# Anveshan Environment Configuration (PDEU Deployment)

# General
PROJECT_NAME="ANVESHAN - Organizational Knowledge & Decision Intelligence Platform"
VERSION=1.0.0
DEFAULT_ORG_ID=PDEU

# Security
SECRET_KEY=anveshan-secret-key-pdeu-academic-intelligence-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite for instant portability; use PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./anveshan.db
# DATABASE_URL=postgresql+asyncpg://anveshan_user:anveshan_password@localhost:5432/anveshan_db

# LLM Gateway Settings (Supports: "auto", "gemini", "openai", "fallback")
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=

# Knowledge Graph (Neo4j - Optional for Enterprise Deployments; built-in Graph Engine active by default)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=anveshan2026
